# Copy to web/.env.local (Next.js only reads env files from web/).
# Base URL of the FastAPI backend; the browser calls it directly (PLAN P7, CORS allows :3000).
# Use the same hostname you open the app on: the session cookie is per hostname, so
# web on http://127.0.0.1:3000 + API on http://localhost:8000 can't sign in. Open the app at
# http://localhost:3000 (`pnpm dev` doesn't even start the page on 127.0.0.1).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# 1 = use lib/mock/mockApi.ts + lib/mock/sample-result.json instead of the real API. Mock mode has
# fake accounts (admin, user, alice, newbie, disabled); any password except "wrong" signs in.
NEXT_PUBLIC_API_MOCK=0
# Mock mode only: a video (put it in web/public/) shown when a result has no blob: URL, e.g. after a
# reload of /jobs/<id>.
# NEXT_PUBLIC_API_MOCK_VIDEO_URL=/mock-preview.mp4
