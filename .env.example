# Mimic configuration. Copy to `.env` (repo root) for the backend; every value is optional.
# No secrets live here: the Claude CLI uses its own login under $HOME, not an API key.
# The openai_compat token (MIMIC_LLM_API_KEY) belongs in your local `.env` only.

# ---- backend (api/, read by app/config.py, prefix MIMIC_) ----------------------------------
# Root for mimic.db and jobs/<id>/ (relative paths resolve against the repo root).
MIMIC_DATA_DIR=data
MIMIC_MAX_UPLOAD_MB=200
MIMIC_MAX_DURATION_S=15.0
MIMIC_MIN_DURATION_S=0.5
# Extra seconds allowed over MIMIC_MAX_DURATION_S during upload validation.
MIMIC_DURATION_TOLERANCE_S=0.5

# Layer B interpreter: claude_cli | openai_compat | none.
# AI labeling is still opt-in per upload (default off), or per finished job via
# POST /api/jobs/{id}/interpret ("re-run"); only then are keyframes sent.
MIMIC_INTERPRETER=claude_cli
MIMIC_CLAUDE_BIN=claude
MIMIC_CLAUDE_MODEL=sonnet
MIMIC_CLAUDE_TIMEOUT_S=120

# openai_compat: any OpenAI-compatible gateway (POST {base_url}/chat/completions, GET /models).
# Put the real token only in your local `.env` (gitignored), never in this file.
# MIMIC_LLM_BASE_URL=http://localhost:20128/v1
# MIMIC_LLM_API_KEY=<your-gateway-token>
# MIMIC_LLM_MODEL=<model-id-that-accepts-images>
MIMIC_LLM_TIMEOUT_S=120
# auto = try response_format json_schema -> json_object -> prompt-only; true/false to force.
MIMIC_LLM_SUPPORTS_JSON_SCHEMA=auto

# Background executor size (jobs run serially with 1).
MIMIC_WORKERS=1
# Comma-separated list of allowed browser origins.
MIMIC_CORS_ORIGINS=http://localhost:3000
MIMIC_FFMPEG_BIN=ffmpeg
MIMIC_FFPROBE_BIN=ffprobe
# 1 = every job also writes data/jobs/<id>/debug/: energy.csv, segments.json, elements.json,
# summary.json, masks/*.png (state frames + change mask), tracks/*.csv (per-frame series).
# The images are crops of the recording; README "Debugging" lists every file.
MIMIC_DEBUG=0

# ---- frontend (web/, Next.js reads these from web/.env.local — see web/.env.local.example) --
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_API_MOCK=0
